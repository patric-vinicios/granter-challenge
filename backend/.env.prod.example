# Copy to .env.prod and fill in every value, then:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up --build -d

# Generate each one separately with: mix phx.gen.secret
SECRET_KEY_BASE=
JWT_SECRET=

# Public hostname, no scheme and no path.
PHX_HOST=api.example.com

# Comma-separated browser origins allowed to call the API. No localhost default
# in prod.
CORS_ORIGINS=https://app.example.com

# Read by the postgres service, which docker-compose.prod.yml builds
# DATABASE_URL from. Against a managed database, drop these and set
# DATABASE_URL directly, with DATABASE_SSL=true.
POSTGRES_USER=api
POSTGRES_PASSWORD=
POSTGRES_DB=api_prod

# Ecto connections per instance.
POOL_SIZE=10

# Only with a reverse proxy that overwrites x-forwarded-for on every request.
# TRUST_PROXY_HEADERS=true
