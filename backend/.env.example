# Copy to .env:
#
#   cp .env.example .env
#
# The api service in docker-compose.dev.yml reads this file directly.
# For a native run, export it into your shell first:
#
#   set -a; source .env; set +a

# Overrides the credentials in config/dev.exs when set. Inside the Compose
# network the host is the service name; from the host it is the published port.
DATABASE_URL=ecto://postgres:postgres@localhost:54320/api_dev

# Generate with: mix phx.gen.secret
# Boot aborts in every environment except test when either is missing.
# JWT_SECRET signs the API bearer tokens and the socket connect param, so
# changing it invalidates every token already issued.
SECRET_KEY_BASE=iGDL1J4hIVxHBIiKmyC/9K1IyZgAKvUTVfHkNVVvBiN/oNoQjUmPocEJ2rj5rIQV
JWT_SECRET=aM1jP5tXHW2LDXNZvxWumZkCkbUPI5DDfd1cwbYRA0j4OKKuU9tVWSoiMokoJKtV

PORT=4000

# Use 0.0.0.0 inside a container so the published port is reachable;
# 127.0.0.1 keeps a native run local-only.
BIND_IP=127.0.0.1

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
