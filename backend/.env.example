# Copy to .env and adjust as needed:
#
#   cp .env.example .env
#
# The `api` service in docker-compose.dev.yml reads this file directly.
# For a native run, export it into your shell first:
#
#   set -a; source .env; set +a

# Database connection. Overrides the credentials in config/dev.exs when set.
# Inside the Compose network the host is the service name (postgres-dev:5432);
# from the host machine it is localhost on the published port.
DATABASE_URL=ecto://postgres:postgres@localhost:54320/api_dev

# Signs and verifies session/token payloads. Generate with: mix phx.gen.secret
# Boot aborts in every environment except test when this is missing.
SECRET_KEY_BASE=iGDL1J4hIVxHBIiKmyC/9K1IyZgAKvUTVfHkNVVvBiN/oNoQjUmPocEJ2rj5rIQV

# Signs the bearer tokens issued by the authentication endpoints.
# Generate with: mix phx.gen.secret
JWT_SECRET=aM1jP5tXHW2LDXNZvxWumZkCkbUPI5DDfd1cwbYRA0j4OKKuU9tVWSoiMokoJKtV

# HTTP port the endpoint listens on.
PORT=4000

# Interface the endpoint binds to. Use 0.0.0.0 inside a container so the
# published port is reachable; 127.0.0.1 keeps a native run local-only.
BIND_IP=127.0.0.1

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
